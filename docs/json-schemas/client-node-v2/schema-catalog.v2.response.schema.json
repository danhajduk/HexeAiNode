{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-node-v2/schema-catalog.v2.response.schema.json",
  "title": "Schema Catalog V2 Response",
  "description": "Implemented response for GET /api/schemas/client-node/v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_family",
    "version",
    "discovery",
    "apis",
    "catalogs",
    "schemas",
    "documents"
  ],
  "properties": {
    "schema_family": {
      "type": "string",
      "const": "client-node"
    },
    "version": {
      "type": "string",
      "const": "v2"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_path", "client_index_path", "base_url_source"],
      "properties": {
        "openapi_path": {"type": "string", "minLength": 1},
        "client_index_path": {"type": "string", "minLength": 1},
        "base_url_source": {"type": "string", "minLength": 1}
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "method", "api_path", "description", "request_schema_path", "response_schema_path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "DELETE"]},
          "api_path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "request_schema_path": {"type": ["string", "null"]},
          "response_schema_path": {"type": ["string", "null"]}
        }
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "resource_type", "api_path", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "resource_type": {"type": "string", "minLength": 1},
          "api_path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema_id",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "schema_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Implemented",
              "Partially implemented",
              "Not developed",
              "Not verifiable from current repository state",
              "Documented but not implemented",
              "Implemented but undocumented"
            ]
          },
          "api_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "status", "api_path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.md$"},
          "title": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["Implemented", "Partially implemented"]
          },
          "api_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
