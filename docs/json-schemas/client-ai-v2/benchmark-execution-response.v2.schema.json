{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-ai-v2/benchmark-execution-response.v2.schema.json",
  "title": "Benchmark Execution Response V2",
  "description": "Proposed V2+ execution-only benchmark response. Contains target outputs and metadata without correctness scoring. Not implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "task_family",
    "trace_id",
    "results"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "task_family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    }
  },
  "$defs": {
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "status"
      ],
      "properties": {
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "candidate",
            "baseline"
          ],
          "default": "candidate"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "skipped",
            "timeout"
          ]
        },
        "output_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "parsed_output": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "runtime_metrics": {
          "$ref": "#/$defs/runtimeMetrics"
        },
        "error": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "runtimeMetrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "vram_used_mib": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vram_delta_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpu_util_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "load_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
