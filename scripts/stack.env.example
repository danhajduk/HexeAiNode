# Copy this file to scripts/stack.env and set real commands before boot install.

# Base directory where commands should run.
APP_DIR=/home/dan/hexe/HexeAiNode

# Backend process command.
# Example: BACKEND_CMD="PYTHONPATH=src /home/dan/hexe/HexeAiNode/.venv/bin/python -m ai_node.main --api-host 0.0.0.0 --api-port 9002"
BACKEND_CMD="PYTHONPATH=src /home/dan/hexe/HexeAiNode/.venv/bin/python -m ai_node.main --api-host 0.0.0.0 --api-port 9002"

# Frontend process command. Build first with: cd frontend && npm run build
# Example: FRONTEND_CMD="/home/dan/hexe/HexeAiNode/.venv/bin/python scripts/serve-frontend.py --host 0.0.0.0 --port 8081 --dist-dir frontend/dist --backend-host 127.0.0.1 --backend-port 9002"
FRONTEND_CMD="/home/dan/hexe/HexeAiNode/.venv/bin/python scripts/serve-frontend.py --host 0.0.0.0 --port 8081 --dist-dir frontend/dist --backend-host 127.0.0.1 --backend-port 9002"

# Local LLM runtime selection.
LLAMACPP_MODEL_HF="Qwen/Qwen3-8B-GGUF:Q4_K_M"
LLAMACPP_MODEL_ALIAS="qwen3-8b-q4_k_m"
LLAMACPP_CTX_SIZE=4096
LLAMACPP_N_GPU_LAYERS=99

# Experimental local vision runtime selection.
LLAMACPP_VISION_MODEL_HF="ggml-org/Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M"
LLAMACPP_VISION_MODEL_ALIAS="qwen2.5-vl-3b-instruct-q4_k_m"
LLAMACPP_VISION_CTX_SIZE=8192
LLAMACPP_VISION_N_GPU_LAYERS=99
