{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-ai-v2/benchmark-execution-request.v2.schema.json",
  "title": "Benchmark Execution Request V2",
  "description": "Proposed V2+ execution-only benchmark request. The AI Node executes targets and returns evidence without scoring. Not implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "task_family",
    "requested_by",
    "trace_id",
    "inputs",
    "targets"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^v([2-9]|[1-9][0-9]+)\\.[0-9]+$",
      "description": "Benchmark-capable prompt version, for example v2.0."
    },
    "task_family": {
      "$ref": "#/$defs/taskFamily"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "service_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "output_contract": {
      "$ref": "#/$defs/outputContract"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/executionTarget"
      }
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 120
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "taskFamily": {
      "type": "string",
      "enum": [
        "task.classification",
        "task.summarization",
        "task.information_extraction",
        "task.structured_extraction",
        "task.translation",
        "task.sentiment_analysis",
        "task.reasoning",
        "task.chat"
      ]
    },
    "executionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "target_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "examples": [
            "local",
            "openai",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": [
            "candidate",
            "baseline"
          ],
          "default": "candidate"
        },
        "timeout_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "outputContract": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ],
          "default": "json"
        },
        "json_schema": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "parse_json_output": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
