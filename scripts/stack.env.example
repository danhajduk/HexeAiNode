# Copy this file to scripts/stack.env and set real commands before boot install.

# Base directory where commands should run.
APP_DIR=/home/dan/hexe/HexeAiNode

# Backend process command.
# Example: BACKEND_CMD="PYTHONPATH=src /home/dan/hexe/HexeAiNode/.venv/bin/python -m ai_node.main --api-host 0.0.0.0 --api-port 9002"
BACKEND_CMD="PYTHONPATH=src /home/dan/hexe/HexeAiNode/.venv/bin/python -m ai_node.main --api-host 0.0.0.0 --api-port 9002"

# Frontend process command. Build first with: cd frontend && npm run build
# Example: FRONTEND_CMD="/home/dan/hexe/HexeAiNode/.venv/bin/python scripts/serve-frontend.py --host 0.0.0.0 --port 8081 --dist-dir frontend/dist --backend-host 127.0.0.1 --backend-port 9002"
FRONTEND_CMD="/home/dan/hexe/HexeAiNode/.venv/bin/python scripts/serve-frontend.py --host 0.0.0.0 --port 8081 --dist-dir frontend/dist --backend-host 127.0.0.1 --backend-port 9002"

# Local LLM runtime selection.
LLAMACPP_MODEL_HF="Qwen/Qwen3-8B-GGUF:Q4_K_M"
LLAMACPP_MODEL_ALIAS="qwen3-8b-q4_k_m"
LLAMACPP_CTX_SIZE=4096
LLAMACPP_N_GPU_LAYERS=99
HEXE_LOCAL_LLM_GPU_EXCLUSIVE_BLOCKER_ENABLED=true
HEXE_LOCAL_LLM_STOP_FOR_COMFYUI=false
HEXE_LOCAL_LLM_STOP_FOR_GPU_WORKLOADS=true
HEXE_SD_SCRIPTS_TRAINING_MARKER=".run/sd-scripts-training.active"

# Experimental local vision runtime selection.
LLAMACPP_VISION_MODEL_HF="ggml-org/Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M"
LLAMACPP_VISION_MODEL_ALIAS="qwen2.5-vl-3b-instruct-q4_k_m"
LLAMACPP_VISION_CTX_SIZE=8192
LLAMACPP_VISION_N_GPU_LAYERS=99
HEXE_VISION_LLM_ALWAYS_ON_ENABLED=true
HEXE_VISION_LLM_RESIDENCY_CHECK_INTERVAL_SECONDS=60
HEXE_VISION_LLM_GPU_EXCLUSIVE_BLOCKER_ENABLED=true
HEXE_VISION_LLM_STOP_FOR_COMFYUI=true
HEXE_VISION_LLM_STOP_FOR_GPU_WORKLOADS=true

# Experimental local image generation runtime selection.
COMFYUI_IMAGE="hexe-ai-node-comfyui:local"
COMFYUI_REF="master"
COMFYUI_PULID_REF="main"
COMFYUI_HOST="127.0.0.1"
COMFYUI_CONTAINER_NAME="hexe-ai-node-comfyui"
COMFYUI_SOCKET_DIR="/run/hexe/ai-node"
COMFYUI_GPU_SOCKET_PATH="/run/hexe/ai-node/comfyui-gpu.sock"
COMFYUI_GPU_HEALTH_SOCKET="/run/hexe/ai-node/comfyui-gpu-health.sock"
COMFYUI_CPU_SOCKET_PATH="/run/hexe/ai-node/comfyui-cpu.sock"
COMFYUI_CPU_HEALTH_SOCKET="/run/hexe/ai-node/comfyui-cpu-health.sock"
COMFYUI_GPU_CHECKPOINT="RealVisXL_V5.0_fp16.safetensors"
COMFYUI_GPU_LORA="sdxl_lightning_4step_lora.safetensors"
COMFYUI_GPU_PULID_MODEL_FILE="ip-adapter_pulid_sdxl_fp16.safetensors"
HEXE_COMFYUI_GPU_PRESETS_CONFIG="config/comfyui-gpu-presets.json"
COMFYUI_CPU_CHECKPOINT="DreamShaper8_LCM.safetensors"
HEXE_COMFYUI_WEBUI_IDLE_TIMEOUT_SECONDS=900
COMFYUI_GPU_VISION_GATE_ENABLED=true
COMFYUI_GPU_VISION_GATE_TIMEOUT_S=90
HEXE_COMFYUI_CPU_QUEUE_CONCURRENCY=1
