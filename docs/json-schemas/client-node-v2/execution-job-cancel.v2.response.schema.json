{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-node-v2/execution-job-cancel.v2.response.schema.json",
  "title": "Execution Job Cancellation Response V2",
  "description": "Cancellation result. HTTP 200 returns a cancelled job; HTTP 409 returns the rejection form when running interruption is unsupported or unavailable, or when the job is already terminal.",
  "oneOf": [
    {
      "allOf": [
        {"$ref": "execution-job.v2.schema.json"},
        {"type": "object", "properties": {"status": {"const": "cancelled"}}, "required": ["status"]}
      ]
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["job_id", "status", "cancellable", "cancel_rejected_reason"],
      "properties": {
        "job_id": {"type": "string"},
        "status": {"type": "string"},
        "cancellable": {"const": false},
        "cancel_rejected_reason": {
          "type": "string",
          "enum": [
            "running_cancellation_unsupported",
            "running_cancellation_unavailable",
            "job_already_completed",
            "job_already_failed",
            "job_already_cancelled",
            "job_already_expired_wait_budget"
          ],
          "description": "Stable reason identifying unsupported/unavailable running interruption or an already-terminal job."
        }
      }
    }
  ]
}
