{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-node-v2/assistant-reasoning.v1.response.schema.json",
  "title": "Assistant Reasoning V1 Response",
  "type": "object",
  "required": ["schema_version", "request_id", "turn_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "turn_id": {"type": "string"},
    "status": {"const": "queued"},
    "job": {"type": "object"},
    "outcome": {"enum": ["intent_candidate", "clarification", "no_match_chat", "refusal", "provider_error"]},
    "intent_name": {"type": "string"},
    "arguments": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "question": {"type": "string"},
    "candidate_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "response": {"type": "string"},
    "reason_code": {"type": "string"},
    "message": {"type": "string"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      }
    },
    "execution": {"type": "object"}
  },
  "oneOf": [
    {"required": ["status", "job"]},
    {"properties": {"outcome": {"const": "intent_candidate"}}, "required": ["outcome", "intent_name", "arguments", "confidence", "execution"]},
    {"properties": {"outcome": {"const": "clarification"}}, "required": ["outcome", "question", "candidate_names", "execution"]},
    {"properties": {"outcome": {"const": "no_match_chat"}}, "required": ["outcome", "response", "execution"]},
    {"properties": {"outcome": {"const": "refusal"}}, "required": ["outcome", "reason_code", "message", "execution"]},
    {"properties": {"outcome": {"const": "provider_error"}}, "required": ["outcome", "error", "execution"]}
  ]
}
