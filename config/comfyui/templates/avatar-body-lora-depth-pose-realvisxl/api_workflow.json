  "12": {"class_type": "DepthAnythingV2Preprocessor", "inputs": {"image": ["11", 0], "ckpt_name": "{{depth_anything_model}}", "resolution": "{{depth_resolution}}"}},
  "13": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "{{body_depth_controlnet}}"}},
  "14": {"class_type": "ControlNetApplyAdvanced", "inputs": {"positive": ["4", 0], "negative": ["5", 0], "control_net": ["13", 0], "image": ["12", 0], "strength": "{{body_depth_strength}}", "start_percent": "{{body_depth_start}}", "end_percent": "{{body_depth_end}}"}},
  "15": {"class_type": "LoadImage", "inputs": {"image": "{{pose_depth_reference_image}}"}},
  "16": {"class_type": "ResizeAndPadImage", "inputs": {"image": ["15", 0], "target_width": "{{width}}", "target_height": "{{height}}", "padding_color": "black", "interpolation": "lanczos"}},
  "17": {"class_type": "DepthAnythingV2Preprocessor", "inputs": {"image": ["16", 0], "ckpt_name": "{{depth_anything_model}}", "resolution": "{{depth_resolution}}"}},
  "18": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "{{body_depth_controlnet}}"}},
  "19": {"class_type": "ControlNetApplyAdvanced", "inputs": {"positive": ["14", 0], "negative": ["14", 1], "control_net": ["18", 0], "image": ["17", 0], "strength": "{{pose_depth_strength}}", "start_percent": "{{pose_depth_start}}", "end_percent": "{{pose_depth_end}}"}},
  "20": {"class_type": "LoadImage", "inputs": {"image": "{{pose_reference_image}}"}},
  "21": {"class_type": "ResizeAndPadImage", "inputs": {"image": ["20", 0], "target_width": "{{width}}", "target_height": "{{height}}", "padding_color": "black", "interpolation": "nearest-exact"}},
  "22": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "{{pose_controlnet}}"}},
  "23": {"class_type": "ControlNetApplyAdvanced", "inputs": {"positive": ["19", 0], "negative": ["19", 1], "control_net": ["22", 0], "image": ["21", 0], "strength": "{{pose_strength}}", "start_percent": "{{pose_start}}", "end_percent": "{{pose_end}}"}},
  "24": {"class_type": "IPAdapterUnifiedLoader", "inputs": {"model": ["2", 0], "preset": "STANDARD (medium strength)"}},
  "25": {"class_type": "IPAdapterTiled", "inputs": {"model": ["24", 0], "ipadapter": ["24", 1], "image": ["11", 0], "weight": "{{body_identity_strength}}", "weight_type": "{{body_identity_weight_type}}", "combine_embeds": "average", "start_at": "{{body_identity_start}}", "end_at": "{{body_identity_end}}", "sharpening": "{{body_identity_sharpening}}", "embeds_scaling": "V only"}},
  "30": {"class_type": "KSampler", "inputs": {"model": ["25", 0], "positive": ["23", 0], "negative": ["23", 1], "latent_image": ["3", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "sgm_uniform", "denoise": "{{denoise}}"}},
  "31": {"class_type": "VAEDecode", "inputs": {"samples": ["30", 0], "vae": ["1", 2]}},
  "32": {"class_type": "SaveImage", "inputs": {"images": ["31", 0], "filename_prefix": "hexe/avatar_body_lora/{{avatar_name}}_seed{{seed}}"}}
}
