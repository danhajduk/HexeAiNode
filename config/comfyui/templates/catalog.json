{
  "schema_version": "1.0",
  "templates": [
    {
      "template_id": "template.txt2img.realvisxl.v1",
      "template_name": "Txt2Img RealVisXL",
      "description": "Reusable normal-operation prompt-only RealVisXL workflow.",
      "runtime_id": "comfyui_gpu",
      "api_workflow_path": "txt2img-realvisxl/api_workflow.json",
      "ui_workflow_path": "txt2img-realvisxl/ui_workflow.json",
      "variables": [
        {
          "name": "positive_prompt",
          "type": "string",
          "required": true,
          "description": "Rendered positive prompt."
        },
        {
          "name": "negative_prompt",
          "type": "string",
          "required": false,
          "description": "Prompt terms to suppress."
        },
        {
          "name": "width",
          "type": "integer",
          "required": false,
          "description": "Output width."
        },
        {
          "name": "height",
          "type": "integer",
          "required": false,
          "description": "Output height."
        },
        {
          "name": "seed",
          "type": "integer",
          "required": false,
          "description": "Sampler seed. Use null for runtime randomization."
        },
        {
          "name": "steps",
          "type": "integer",
          "required": false,
          "description": "Sampler step count."
        },
        {
          "name": "cfg",
          "type": "number",
          "required": false,
          "description": "Classifier-free guidance scale."
        }
      ],
      "defaults": {
        "negative_prompt": "low quality, blurry, distorted text, watermark",
        "width": 1024,
        "height": 1024,
        "seed": null,
        "steps": 4,
        "cfg": 1.6
      },
      "model_requirements": {
        "checkpoint": "RealVisXL_V5.0_fp16.safetensors",
        "loras": ["sdxl_lightning_4step_lora.safetensors"],
        "vae": null,
        "controlnets": []
      },
      "output_scope": "normal",
      "metadata": {
        "preset_family": "realvisxl_lightning",
        "domain": "general",
        "input_mode": "text"
      }
    },
    {
      "template_id": "template.avatar_reference.realvisxl.v1",
      "template_name": "Avatar References RealVisXL",
      "description": "Avatar workflow that applies prompt edits while conditioning on selected face and body reference images.",
      "runtime_id": "comfyui_gpu",
      "api_workflow_path": "avatar-reference-realvisxl/api_workflow.json",
      "ui_workflow_path": "avatar-reference-realvisxl/ui_workflow.json",
      "variables": [
        {
          "name": "positive_prompt",
          "type": "string",
          "required": true,
          "description": "Rendered avatar edit prompt."
        },
        {
          "name": "input_image",
          "type": "image",
          "required": true,
          "description": "Source avatar image."
        },
        {
          "name": "face_reference_image",
          "type": "image",
          "required": true,
          "description": "Reference image for face identity."
        },
        {
          "name": "body_reference_image",
          "type": "image",
          "required": true,
          "description": "Reference image for body shape and pose guidance."
        },
        {
          "name": "negative_prompt",
          "type": "string",
          "required": false,
          "description": "Prompt terms to suppress."
        },
        {
          "name": "avatar_name",
          "type": "string",
          "required": false,
          "description": "Filesystem-safe avatar name used in output filenames."
        },
        {
          "name": "width",
          "type": "integer",
          "required": false,
          "description": "Output width."
        },
        {
          "name": "height",
          "type": "integer",
          "required": false,
          "description": "Output height."
        },
        {
          "name": "seed",
          "type": "integer",
          "required": false,
          "description": "Sampler seed. Use null for runtime randomization."
        },
        {
          "name": "steps",
          "type": "integer",
          "required": false,
          "description": "Sampler step count."
        },
        {
          "name": "cfg",
          "type": "number",
          "required": false,
          "description": "Classifier-free guidance scale."
        },
        {
          "name": "denoise",
          "type": "number",
          "required": false,
          "description": "Prompt application strength for the avatar source image."
        }
      ],
      "defaults": {
        "negative_prompt": "low quality, blurry, distorted face, distorted hands, extra limbs, malformed body, watermark, text",
        "avatar_name": "avatar",
        "width": 1024,
        "height": 1024,
        "seed": null,
        "steps": 4,
        "cfg": 1.8,
        "denoise": 0.82
      },
      "model_requirements": {
        "checkpoint": "RealVisXL_V5.0_fp16.safetensors",
        "loras": ["sdxl_lightning_4step_lora.safetensors"],
        "vae": null,
        "controlnets": [],
        "other": {
          "nodes": ["ReferenceLatent"]
        }
      },
      "output_scope": "normal",
      "metadata": {
        "preset_family": "realvisxl_lightning",
        "domain": "avatar",
        "input_mode": "image",
        "edit_intent": "apply_prompt_with_face_body_references",
        "reference_roles": ["source", "face", "body"]
      }
    },
