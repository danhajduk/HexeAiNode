{
  "schema_version": "hexe_lora_training_template_v1",
  "template_id": "template.avatar_body_identity_bootstrap.kohya_sdxl.v1",
  "template_name": "Avatar Body Identity Bootstrap - Kohya SDXL",
  "description": "Conservative preliminary body-identity LoRA trained from an approved front-neutral body reference set.",
  "runner": "kohya_ss_sd_scripts",
  "model": {
    "pretrained_model_name_or_path": "runtime/models/comfyui-gpu/checkpoints/RealVisXL_V5.0_fp16.safetensors",
    "v2": false,
    "v_parameterization": false,
    "sdxl": true
  },
  "dataset": {
    "resolution": 768,
    "caption_extension": ".txt",
    "keep_tokens": 2,
    "shuffle_caption": false,
    "repeats": 6
  },
  "training": {
    "output_name_suffix": "upper_torso_identity_bootstrap",
    "network_module": "networks.lora",
    "network_dim": 24,
    "network_alpha": 12,
    "train_batch_size": 1,
    "max_train_epochs": 6,
    "learning_rate": 0.00008,
    "unet_lr": 0.00008,
    "text_encoder_lr": 0,
    "lr_scheduler": "cosine",
    "lr_warmup_steps": 20,
    "optimizer_type": "AdamW8bit",
    "mixed_precision": "fp16",
    "save_precision": "fp16",
    "cache_latents": true,
    "cache_latents_to_disk": true,
    "gradient_checkpointing": true,
    "persistent_data_loader_workers": false,
    "max_data_loader_n_workers": 1,
    "save_every_n_epochs": 1,
    "seed": 1781128029
  },
  "hardware": {
    "minimum_vram_gb": 12,
    "recommended_free_vram_gb": 10,
    "notes": [
      "Stop image generation before training.",
      "The Image Studio GPU lease prevents text and vision LLMs from loading during training."
    ]
  }
}
