{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-node-v2/execution-job.v2.schema.json",
  "title": "Execution Job V2",
  "description": "Queued acknowledgement and GET /api/execution/jobs/{job_id} status payload.",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "job_id", "check_after_seconds"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed", "cancelled", "expired_wait_budget"]
    },
    "job_id": {"type": "string", "pattern": "^job-[a-f0-9]+$"},
    "job_name": {"type": ["string", "null"]},
    "status_url": {"type": ["string", "null"]},
    "check_after_seconds": {"type": "integer", "minimum": 1},
    "queue": {"type": ["string", "null"]},
    "runtime_lane": {"type": ["string", "null"]},
    "queue_position": {"type": ["integer", "null"], "minimum": 1},
    "eta": {"type": ["object", "null"], "additionalProperties": true},
    "queue_state": {"type": ["object", "null"], "additionalProperties": true},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "queued_at": {"type": ["string", "null"], "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time", "description": "Terminal status-record expiration time. Expired terminal records are deleted automatically; this timestamp never cancels active work."},
    "running_cancellation_supported": {"type": "boolean", "description": "Whether a running job can be cooperatively interrupted by this provider/runtime path."},
    "cancellation_requested_at": {"type": ["string", "null"], "format": "date-time"},
    "cancellation_reason": {"type": ["string", "null"]},
    "result": {
      "anyOf": [
        {"$ref": "execution-response.v2.schema.json"},
        {"type": "null"}
      ]
    },
    "artifact_ack": {
      "type": ["object", "null"],
      "description": "Present on completed jobs with image artifacts. POST the supplied body only after every artifact has been retrieved successfully; acknowledgement permits immediate deletion of node-local copies.",
      "additionalProperties": false,
      "required": ["url", "method", "body", "meaning"],
      "properties": {
        "url": {"const": "/api/execution/artifacts/ack"},
        "method": {"const": "POST"},
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["job_id"],
          "properties": {"job_id": {"type": "string", "pattern": "^job-[a-f0-9]+$"}}
        },
        "meaning": {"const": "all_artifacts_retrieved_and_no_longer_needed"}
      }
    },
    "artifact_acknowledgement": {
      "anyOf": [
        {"$ref": "execution-artifact-ack.v1.response.schema.json"},
        {"type": "null"}
      ]
    },
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "recovered_at", "original_status"],
      "properties": {
        "status": {"type": "string", "enum": ["queued_for_resume", "not_replayed", "failed"]},
        "recovered_at": {"type": "string", "format": "date-time"},
        "original_status": {"type": "string", "enum": ["queued", "running"]}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
