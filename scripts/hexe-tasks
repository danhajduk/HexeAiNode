#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
coordination_root="${HEXE_COORDINATION_ROOT:-$(dirname "$project_root")/HexeCoordination}"

exec "$coordination_root/scripts/hexe-tasks" \
  --project ai-node \
  --project-root "$project_root" \
  "$@"
