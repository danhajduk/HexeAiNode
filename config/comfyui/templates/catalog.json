{
  "schema_version": "1.0",
  "templates": [
    {
      "template_id": "template.avatar_body_depth_reference_transparent.realvisxl.v1",
      "template_name": "Avatar Body Depth Reference Transparent RealVisXL",
      "description": "Transparent avatar workflow that uses a face reference for identity and a padded body reference depth map through SDXL ControlNet, saves an RGB fallback, then removes the background.",
      "runtime_id": "comfyui_gpu",
      "api_workflow_path": "avatar-body-depth-reference-transparent-realvisxl/api_workflow.json",
      "ui_workflow_path": "avatar-body-depth-reference-transparent-realvisxl/ui_workflow.json",
      "variables": [
        {
          "name": "positive_prompt",
          "type": "string",
          "required": true,
          "description": "Rendered avatar scene prompt."
        },
        {
          "name": "face_reference_image",
          "type": "image",
          "required": true,
          "description": "Reference image for face identity."
        },
        {
          "name": "body_reference_image",
          "type": "image",
          "required": true,
          "description": "Reference image for body proportions, pose, and silhouette depth guidance."
        },
        {
          "name": "face_strength",
          "type": "number",
          "required": false,
          "description": "Face reference strength from 0 to 1."
        },
        {
          "name": "body_depth_strength",
          "type": "number",
          "required": false,
          "description": "Body depth ControlNet strength from 0 to 1. Higher values follow the body reference depth map more strongly."
        },
        {
          "name": "body_depth_start",
          "type": "number",
          "required": false,
          "description": "Sampler percentage where body depth ControlNet begins applying."
        },
        {
          "name": "body_depth_end",
          "type": "number",
          "required": false,
          "description": "Sampler percentage where body depth ControlNet stops applying."
        },
        {
          "name": "depth_resolution",
          "type": "integer",
          "required": false,
          "description": "Resolution used by the Depth Anything V2 preprocessor."
        },
        {
          "name": "depth_anything_model",
          "type": "string",
          "required": false,
          "description": "Depth Anything V2 annotator checkpoint filename."
        },
        {
          "name": "body_depth_controlnet",
          "type": "string",
          "required": false,
          "description": "Local SDXL depth ControlNet model filename."
        },
        {
          "name": "negative_prompt",
          "type": "string",
          "required": false,
          "description": "Prompt terms to suppress."
        },
        {
          "name": "avatar_name",
          "type": "string",
          "required": false,
          "description": "Filesystem-safe avatar name used in output filenames."
        },
        {
          "name": "bg_removal_model",
          "type": "string",
          "required": false,
          "description": "Local ComfyUI background-removal model filename."
        },
        {
          "name": "width",
          "type": "integer",
          "required": false,
          "description": "Output width."
        },
        {
          "name": "height",
          "type": "integer",
          "required": false,
          "description": "Output height."
        },
        {
          "name": "seed",
          "type": "integer",
          "required": false,
          "description": "Sampler seed. Use null for runtime randomization."
        },
        {
          "name": "steps",
          "type": "integer",
          "required": false,
          "description": "Sampler step count."
        },
        {
          "name": "cfg",
          "type": "number",
          "required": false,
          "description": "Classifier-free guidance scale."
        },
        {
          "name": "denoise",
          "type": "number",
          "required": false,
          "description": "Sampler denoise. This template starts from empty latent, so 1.0 gives the cleanest new composition."
        }
      ],
      "defaults": {
        "negative_prompt": "busy background, detailed background, cropped head, cropped face, cropped body, out of frame, close-up crop, torso crop, missing legs, missing feet, different body shape, changed identity, altered face, low quality, blurry, distorted face, distorted hands, extra limbs, malformed body, watermark, text",
        "avatar_name": "avatar",
        "bg_removal_model": "birefnet.safetensors",
        "width": 768,
        "height": 1152,
        "seed": null,
        "steps": 4,
        "cfg": 1.2,
        "denoise": 1,
        "face_strength": 0.8,
        "body_depth_strength": 0.75,
        "body_depth_start": 0,
        "body_depth_end": 0.8,
        "depth_resolution": 768,
        "depth_anything_model": "depth_anything_v2_vits.pth",
        "body_depth_controlnet": "controlnet-depth-sdxl-1.0-fp16.safetensors"
      },
      "model_requirements": {
        "checkpoint": "RealVisXL_V5.0_fp16.safetensors",
        "loras": [
          "sdxl_lightning_4step_lora.safetensors"
        ],
        "vae": null,
        "controlnets": [
          "controlnet-depth-sdxl-1.0-fp16.safetensors"
        ],
        "other": {
          "nodes": [
            "ReferenceLatent",
            "ConditioningAverage",
            "ResizeAndPadImage",
            "DepthAnythingV2Preprocessor",
            "ControlNetLoader",
            "ControlNetApplyAdvanced",
            "LoadBackgroundRemovalModel",
            "RemoveBackground",
            "InvertMask",
            "JoinImageWithAlpha",
            "SaveImage"
          ],
          "identity_strength": "fallback_reference_latent_not_faceid",
          "body_preservation": "depth_anything_v2_controlnet",
          "body_reference_fit": "resize_and_pad_to_output_aspect",
          "background_removal": "birefnet.safetensors"
        }
      },
      "output_scope": "normal",
      "metadata": {
        "preset_family": "realvisxl_lightning",
        "domain": "avatar",
        "input_mode": "text",
        "edit_intent": "body_depth_controlnet_composition_with_avatar_references_transparent_background",
        "reference_roles": [
          "face",
          "body"
        ],
        "transparent_background": true
      }
    }
  ]
}
