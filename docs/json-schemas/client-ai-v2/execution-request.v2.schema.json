{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexe.local/schemas/client-ai-v2/execution-request.v2.schema.json",
  "title": "Execution Request V2",
  "description": "Implemented request contract for POST /api/execution/direct and /api/execution/route-preview.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_family",
    "requested_by",
    "trace_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "task_family": {
      "$ref": "#/$defs/taskFamily"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "service_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "customer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "requested_provider": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "requested_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "properties": {
        "routing_policy": {
          "$ref": "#/$defs/requestRoutingPolicy"
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "background",
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "queue": {
      "$ref": "#/$defs/queueIntent"
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "sync",
        "async_if_queued"
      ],
      "default": "sync",
      "description": "Use sync for inline execution. Use async_if_queued to return a queued job response and poll /api/execution/jobs/{job_id}."
    },
    "job_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 255,
      "description": "Optional human-readable queued job label. Defaults to task_id."
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 60
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "taskFamily": {
      "type": "string",
      "pattern": "^task\\.[a-z0-9][a-z0-9._/-]{1,122}$",
      "description": "Must be a task family accepted by the live node capability taxonomy."
    },
    "requestRoutingPolicy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "local_only",
            "local_preferred",
            "cloud_only",
            "cloud_fallback"
          ],
          "description": "Per-request routing mode. The request may narrow a V3 prompt routing boundary but must not broaden it."
        }
      }
    },
    "queueIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importance": {
          "type": "string",
          "enum": [
            "background",
            "low",
            "normal",
            "high",
            "critical"
          ],
          "default": "normal",
          "description": "Business/user urgency. The scheduler sorts by importance before per-bucket priority."
        },
        "priority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "background",
            "low",
            "normal",
            "high",
            "critical",
            null
          ],
          "description": "Ordering hint within the same importance bucket. Defaults to importance."
        },
        "queue_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "interactive",
            "background",
            "scheduled",
            null
          ],
          "description": "Interactive work gets a short default wait budget; background work gets a long default wait budget."
        },
        "runtime_lane": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cloud",
            "text_llm",
            "vision_llm",
            "visual_gpu",
            "visual_cpu",
            "training_runtime",
            null
          ],
          "description": "Dedicated runtime lane. If omitted, the node infers it from task family, requested provider, and routing."
        },
        "max_wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "allow_cloud_spillover": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "local_preferred": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "routing_policy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "local_only",
            "local_preferred",
            "cloud_fallback",
            "cloud_only",
            null
          ]
        },
        "estimated_vram_mib": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_runtime_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    }
  }
}
