{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "sdxl_lightning_4step_lora.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "3": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "{{positive_prompt}}"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "{{negative_prompt}}"
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["3", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "sgm_uniform",
      "denoise": "{{denoise}}"
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "{{bg_removal_model}}"
    }
  },
  "9": {
    "class_type": "RemoveBackground",
    "inputs": {
      "image": ["7", 0],
      "bg_removal_model": ["8", 0]
    }
  },
  "10": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": ["9", 0]
    }
  },
  "11": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": ["7", 0],
      "alpha": ["10", 0]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "hexe/avatar_head_face_preview/{{avatar_name}}_seed{{seed}}_rgb"
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "hexe/avatar_head_face_preview/{{avatar_name}}_seed{{seed}}"
    }
  }
}
